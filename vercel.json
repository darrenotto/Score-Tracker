{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "score-tracker-virid.vercel.app" }],
      "destination": "https://duelpoin.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/badminton", "destination": "/badminton.html" },
    { "source": "/volleyball", "destination": "/volleyball.html" },
    { "source": "/tennis", "destination": "/tennis.html" },
    { "source": "/table-tennis", "destination": "/table-tennis.html" },
    { "source": "/padel", "destination": "/padel.html" },
    { "source": "/basketball", "destination": "/basketball.html" },
    { "source": "/squash", "destination": "/squash.html" },
    { "source": "/((?!(?:about|privacy|contact|terms|rules)(?:/|$))(?!.*\\.).*)", "destination": "/index.html" }
  ]
}